<?xml version="1.0" encoding="utf-8"?><!--
   Tokens are encrypted with an Android Keystore key that is never backed up,
   so the session DataStore file is useless on another device and must stay out of backups.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <exclude domain="file" path="datastore/session.preferences_pb" />
</full-backup-content>